# RAGLense - Environment Configuration
# Copy this to .env and fill in your values

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=RAGLense
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://raglense:raglense@localhost:5432/raglense
DATABASE_ECHO=false

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Clerk (optional override)
CLERK_JWKS_URL=

# ──────────────────────────────────────────────
# File Storage
# ──────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# MinIO / S3 (optional)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=raglense

# Supabase Storage (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=raglense

# ──────────────────────────────────────────────
# LLM Providers (add your API keys)
# ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096

# ──────────────────────────────────────────────
# Embeddings
# ──────────────────────────────────────────────
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSION=1536

# ──────────────────────────────────────────────
# Vector Database
# ──────────────────────────────────────────────
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_data

# ──────────────────────────────────────────────
# Chunking
# ──────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_CHUNKING_STRATEGY=recursive

# ──────────────────────────────────────────────
# Retrieval
# ──────────────────────────────────────────────
DEFAULT_TOP_K=5
DEFAULT_SEARCH_TYPE=hybrid

# ──────────────────────────────────────────────
# Celery
# ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
