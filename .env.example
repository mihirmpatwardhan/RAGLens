# RAGLense environment

## App
APP_NAME=RAGLense
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

## Database
DATABASE_URL=postgresql+asyncpg://raglense:raglense@localhost:5432/raglense
DATABASE_ECHO=false

## Redis
REDIS_URL=redis://localhost:6379/0

## Legacy JWT settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

## Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

## File storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=raglense
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=raglense

## Provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

## Runtime defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096
## Phase 2: LLM fallback chain — tried in order when primary provider fails
## Comma-separated list: openai,anthropic,google (any provider with a key configured)
LLM_FALLBACK_CHAIN=["openai","anthropic","google"]
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1.0
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSION=1536
## Phase 2: Embedding fallback — fall back to local bge-small-en-v1.5 when OpenAI fails
EMBEDDING_FALLBACK_TO_LOCAL=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSION=384
## Vector Database (Phase 3: Qdrant is now the default)
VECTOR_DB_PROVIDER=qdrant
## Qdrant (primary)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false
## ChromaDB (legacy / migration source — kept for backward compat)
CHROMA_PERSIST_DIR=./chroma_data
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_CHUNKING_STRATEGY=recursive
DEFAULT_TOP_K=5
DEFAULT_SEARCH_TYPE=hybrid

## Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

## Frontend routing
BACKEND_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8000

## ─── Phase 1: Reranking ─────────────────────────────────────────────────────
## Set to false to skip cross-encoder entirely and sort by cosine similarity only
ENABLE_RERANKING=true
## Cross-encoder model (lighter): cross-encoder/ms-marco-MiniLM-L-6-v2
## Heavier (better): BAAI/bge-reranker-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
## Number of candidates fetched from vector DB before reranking (pre-rerank pool)
RERANK_CANDIDATES=20
## Number of top chunks to keep after reranking (passed to LLM context window)
RERANK_TOP_N=5

## ─── Phase 4: LangGraph HITL ────────────────────────────────────────────────
## Minimum cosine similarity score; below this threshold the CriticAgent flags
## retrieved chunks for human review before generating a response.
## Set to 0.0 to disable HITL (critic always approves).
CRITIC_MIN_SCORE=0.3

## ─── Phase 5: Layout-Aware PDF Parsing ──────────────────────────────────────
## Set to true to use the unstructured library for layout-aware PDF parsing.
## Enables parent-child hierarchical chunking for tables, headers, and images.
## Falls back gracefully to flat pymupdf extraction if unstructured is not installed.
ENABLE_LAYOUT_PARSER=true

## ─── Phase 7: Temporal Memory ────────────────────────────────────────────────
## Audio/video transcription model size (tiny|base|small|medium|large-v2)
## base = ~145MB, good accuracy/speed; tiny = ~74MB, faster but less accurate
WHISPER_MODEL_SIZE=base

## GitHub code ingestion — local clone directory for tree-sitter AST chunking
GITHUB_CLONE_DIR=./storage/repos

## ─── Future Extensions (documented, not yet implemented) ────────────────────
## WhatsApp export connector — SKIPPED (low value, high integration effort)
# WHATSAPP_EXPORT_DIR=
## Google Calendar sync — SKIPPED (low value, complex auth)
# GOOGLE_CALENDAR_CREDENTIALS=
