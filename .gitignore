*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/

# Python tools
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ──────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ──────────────────────────────────────────────
# IDE
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────
# Environment & Secrets — NEVER commit these
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ──────────────────────────────────────────────
# Database files (generated at runtime)
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# SQLite WAL-mode journal files (these contain live user data)
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# ──────────────────────────────────────────────
# Vector store data (user data — never commit)
# ──────────────────────────────────────────────
chroma_data/
qdrant_data/
faiss_index/
/storage/
backend/storage/
uploads/
!backend/app/infrastructure/storage/

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
logs/
*.log

# ──────────────────────────────────────────────
# Test & scratch files — not for production
# ──────────────────────────────────────────────
backend/test_*.py
backend/reset_*.py
backend/test_*.pdf
scripts/generate_*.py
scratch/

# PDF reports & summaries (auto-generated)
RAGLens_Updates_Summary.pdf
*.pdf

# ──────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────
docker-compose.override.yml

# ──────────────────────────────────────────────
